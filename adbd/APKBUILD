# Contributor: Mio Naganohara <mio@meow.business>
# Maintainer: Mio Naganohara <mio@meow.business>
pkgname=adbd
# upstream tags use "pN" (e.g. 37.0.0p1); apk wants the "_p" form, which
# also sorts after the plain release
_upstream=36.0.1
pkgver=${_upstream/p/_p}
pkgrel=0
pkgdesc="Standalone Linux Android Debug Bridge daemon (FunctionFS USB transport)"
url="https://github.com/nmeum/android-tools"
arch="aarch64 armv7 riscv64 x86_64"
license="Apache-2.0 AND MIT AND BSD-2-Clause AND BSD-3-Clause"
options="!check"
subpackages="$pkgname-openrc"
# no build deps needed when packaging an externally compiled binary
[ -z "${ADBD_PREBUILT:-}" ] && makedepends="build-base cmake samurai linux-headers"
_brotli_sha=ed738e842d2fbdf2d6459e39267a633c4a9b2f5d
_lz4_sha=ebb370ca83af193212df4dcbadcc5d87bc0de2f0
_zstd_sha=f8745da6ff1ad1e7bab384bd1f9d742439278e99
source="https://github.com/nmeum/android-tools/releases/download/$_upstream/android-tools-$_upstream.tar.xz
	https://github.com/google/brotli/archive/$_brotli_sha.tar.gz
	https://github.com/lz4/lz4/archive/$_lz4_sha.tar.gz
	https://github.com/facebook/zstd/archive/$_zstd_sha.tar.gz
	0029-adb-add-Linux-TCP-only-daemon-support.patch
	0030-adb-enable-FunctionFS-USB-on-standalone-Linux.patch
	0031-adbd-linux-reboot-service.patch
	0032-adbd-linux-no-tcp-fallback.patch
	0033-adbd-linux-shell-tmpdir.patch
	vendor-CMakeLists.txt
	CMakeLists.adbd-daemon.txt
	adbd-stubs.cpp
	sys-capability.h
	protobuf-descriptor.h
	protobuf-coded-stream.h
	adbd.initd
	adbd.confd
	"
builddir="$srcdir/android-tools-$_upstream"

# The release tarball ships vendor/ already patched with the upstream series,
# so ANDROID_TOOLS_PATCH_VENDOR stays OFF; our patches apply on top with patch(1).
prepare() {
	# packaging an externally cross-compiled binary: sources still get
	# fetched and sha512-verified by abuild, but nothing here is used
	[ -n "$ADBD_PREBUILT" ] && return
	cd "$builddir"
	mkdir -p vendor/third_party
	mv "$srcdir/brotli-$_brotli_sha" vendor/third_party/brotli
	mv "$srcdir/lz4-$_lz4_sha" vendor/third_party/lz4
	mv "$srcdir/zstd-$_zstd_sha" vendor/third_party/zstd
	cp "$srcdir/vendor-CMakeLists.txt" vendor/CMakeLists.txt
	local p
	for p in "$srcdir"/00*.patch; do
		patch -f -p1 -d vendor/adb < "$p"
	done
	cp "$srcdir/CMakeLists.adbd-daemon.txt" vendor/
	mkdir -p vendor/linux-adbd/include/sys vendor/linux-adbd/include/google/protobuf/io
	cp "$srcdir/adbd-stubs.cpp" vendor/linux-adbd/stubs.cpp
	cp "$srcdir/sys-capability.h" vendor/linux-adbd/include/sys/capability.h
	# satisfy sysdeps.h's __has_include protobuf probes without dragging in absl
	cp "$srcdir/protobuf-descriptor.h" vendor/linux-adbd/include/google/protobuf/descriptor.h
	cp "$srcdir/protobuf-coded-stream.h" vendor/linux-adbd/include/google/protobuf/io/coded_stream.h
}

build() {
	if [ -n "$ADBD_PREBUILT" ]; then
		mkdir -p build/vendor
		cp "$ADBD_PREBUILT" build/vendor/adbd
		return
	fi
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DANDROID_TOOLS_PATCH_VENDOR=OFF \
		-DANDROID_TOOLS_USE_BUNDLED_FMT=ON \
		-DANDROID_TOOLS_BUILD_ADBD_ONLY=ON \
		-DANDROID_TOOLS_ADBD_FULLY_STATIC=ON \
		-DANDROID_TOOLS_ADBD_USB=ON
	cmake --build build --target adbd
}

package() {
	install -Dm0755 build/vendor/adbd "$pkgdir"/usr/sbin/adbd
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install -Dm0755 "$srcdir"/adbd.initd "$subpkgdir"/etc/init.d/adbd
	install -Dm0644 "$srcdir"/adbd.confd "$subpkgdir"/etc/conf.d/adbd
}

